<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Spec 31 §3/§5: the macOS runtime signing profile (fixed pair, pinned
  here until spec 31 §2's manifest derivation lands).

  disable-library-validation — EVERY runtime slice: a hardened-runtime
    process by default refuses unsigned dylibs, and the driver
    materializes in-image native extensions (.bundle) to the host for
    dlopen; they carry no Developer ID signature of their own (§1.4).
  allow-jit — YJIT/ZJIT map executable memory at runtime (MAP_JIT on
    arm64). Harmless on a ruby built without a JIT: the entitlement is
    a grant, never a requirement.

  Keep the two <true/> values on their own lines: the embedding check
  in ci/macos-sign-notarize-runtime.sh counts them (macOS 15 emits the
  embedded plist single-line, so it greps for <true/>, not key names).
-->
<plist version="1.0">
<dict>
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
</dict>
</plist>
